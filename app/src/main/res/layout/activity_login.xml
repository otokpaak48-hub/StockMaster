<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/primary_dark" android:gravity="center_horizontal"
    android:orientation="vertical" android:padding="24dp">

    <Space android:layout_width="match_parent" android:layout_height="36dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="📦 StockMaster" android:textColor="@color/white"
        android:textSize="28sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Enter your 4-digit PIN"
        android:textColor="#B3FFFFFF" android:textSize="14sp" />

    <LinearLayout android:id="@+id/pinDots"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:orientation="horizontal">
        <View android:id="@+id/dot1" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="10dp" android:background="@drawable/bg_pin_dot" />
        <View android:id="@+id/dot2" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="10dp" android:background="@drawable/bg_pin_dot" />
        <View android:id="@+id/dot3" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="10dp" android:background="@drawable/bg_pin_dot" />
        <View android:id="@+id/dot4" android:layout_width="16dp" android:layout_height="16dp" android:layout_margin="10dp" android:background="@drawable/bg_pin_dot" />
    </LinearLayout>

    <TextView android:id="@+id/errorText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#FFD54F" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:orientation="horizontal">
        <TextView android:id="@+id/key1" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="1" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key2" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="2" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key3" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="3" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key4" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="4" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key5" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="5" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key6" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="6" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key7" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="7" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key8" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="8" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key9" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="9" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/keyBack" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="⌫" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/key0" android:layout_width="0dp" android:layout_height="62dp" android:layout_margin="6dp" android:layout_weight="1" android:background="@drawable/bg_key" android:gravity="center" android:text="0" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="62dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
